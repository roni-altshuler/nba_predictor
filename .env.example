# The site is fully static and needs none of these to build. They exist for
# local development and for the optional FastAPI process.

# Public site URL, used for OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://hardwood-predictor.vercel.app

# Where the frontend should look for the FastAPI process in development.
# Left empty in production: the deployed site reads artifacts off disk at
# build time and does not call the API at all.
NEXT_PUBLIC_API_URL=
